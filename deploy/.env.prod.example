# Production. Copy to deploy/.env.prod and change the secrets.
#   single machine:  docker compose -f deploy/docker-compose.yml --env-file deploy/.env.prod up -d
#   split machines:  docker compose -f deploy/{infra,runtime,gateway}.yml --env-file deploy/.env.prod up -d
# Each compose file reads only the names it needs, so the same file serves every machine. On a split deployment only
# OPENCODE_ADVERTISE_URL differs between execution layers.

# --- Secrets ---
POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me-redis
# Signs the actor header between gateway and execution layers; identical on the gateway and every layer.
OPENCODE_GATEWAY_SECRET=change-me-gateway
# Operator password of the execution layers.
OPENCODE_PASSWORD=change-me-operator
# First platform administrator, created only when none exists yet (password at least 8 characters).
OPENCODE_ADMIN_EMPLOYEE_ID=admin
OPENCODE_ADMIN_PASSWORD=change-me-admin

# --- Accounts ---
# An organization id or name that accounts with no organization join when they sign in; created by name when it does
# not exist yet. Leave unset to keep the "waiting for an organization" screen for them.
# OPENCODE_DEFAULT_ORGANIZATION=Other
# Guests: opening the web app starts an anonymous account with no password in the default organization above, without
# showing the login screen. Needs OPENCODE_DEFAULT_ORGANIZATION. Guests are ordinary members of that organization;
# signing out returns to the login screen in that tab.
# OPENCODE_GUEST_ENABLED=true

# --- Single machine (docker-compose.yml) ---
WEB_PORT=8080

# --- Connections ---
# Single machine: leave unset to use the bundled postgres and redis containers.
# Split machines: set both, with the passwords above, to the address of the infra machine (or your own servers).
# OPENCODE_IDENTITY_POSTGRES_URL=postgres://opencode:change-me@10.0.0.1:5432/opencode
# OPENCODE_REGISTRY_URL=redis://:change-me-redis@10.0.0.1:6379
# infra.yml publishes these ports on BIND_HOST (default all interfaces):
# POSTGRES_PORT=5432
# REDIS_PORT=6379
# BIND_HOST=0.0.0.0

# Key that seals users' own API keys ("All my organizations") before they are stored in the shared Postgres: 32 random
# bytes in base64, e.g. `openssl rand -base64 32`. Every execution layer needs the same value. Without it the feature is
# off and nothing is stored. Keep it apart from the database and its backups, or the seal protects nothing.
# OPENCODE_SECRET_KEY=
# To rotate: put the new key above and the old one here (comma separated) until every key is saved again.
# OPENCODE_SECRET_KEY_PREVIOUS=

# --- Split machines: execution layer ---
# How the gateway reaches THIS layer. Also its registry id; do not change it once organizations live here.
# OPENCODE_ADVERTISE_URL=http://10.0.0.2:4096
# Seconds between copies of this layer's sessions to the shared Postgres, for analysis. 0 turns the copy off.
# OPENCODE_SESSION_SYNC_INTERVAL=60

# --- Gateway ---
# Browser tab title (default OpenCode).
# OPENCODE_WEB_TITLE=My Company AI

# --- Program package ---
# Release to download (a tag published by script/release.sh). Or set OPENCODE_PACKAGE_URL to the package's own address,
# and OPENCODE_PACKAGE_TOKEN if that address needs a bearer token.
OPENCODE_VERSION=v1.0.0
