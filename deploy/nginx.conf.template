# TLS in front of the Auth gateway. Rendered by the nginx image from the OPENCODE_* variables of the https service (see
# docker-compose.yml / gateway.yml); certificates are read from /etc/nginx/certs/{fullchain,privkey}.pem.

map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

server {
  listen 80;
  server_name _;
  return 301 https://$host$request_uri;
}

server {
  listen 443 ssl;
  http2 on;
  server_name _;

  ssl_certificate     /etc/nginx/certs/fullchain.pem;
  ssl_certificate_key /etc/nginx/certs/privkey.pem;
  ssl_protocols       TLSv1.2 TLSv1.3;

  # Skill and plugin packages are uploaded through here.
  client_max_body_size 64m;

  # The gateway's address is looked up again every few seconds (Docker's resolver), so recreating its container does not
  # leave this proxy talking to an address that now belongs to something else.
  resolver 127.0.0.11 valid=10s;
  set $upstream http://${OPENCODE_UPSTREAM};

  location / {
    proxy_pass $upstream;
    proxy_http_version 1.1;

    # /api/event is a long-lived SSE stream and terminals are WebSockets.
    proxy_buffering off;
    proxy_read_timeout 1h;
    proxy_send_timeout 1h;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;

    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
}
