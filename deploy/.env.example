POSTGRES_PASSWORD=change-me
OPENCODE_PASSWORD=change-me-operator
OPENCODE_GATEWAY_SECRET=change-me-gateway
ADMIN_EMPLOYEE_ID=admin
ADMIN_PASSWORD=change-me-admin
WEB_PORT=8080

# Connections. Leave unset to use the bundled postgres and redis containers; set to use your own servers.
# OPENCODE_IDENTITY_POSTGRES_URL=postgres://opencode:password@db.internal:5432/opencode
# OPENCODE_REGISTRY_URL=redis://redis.internal:6379

# Release to download (a tag published by script/release.sh). Or set OPENCODE_PACKAGE_URL to the package's own address,
# and OPENCODE_PACKAGE_TOKEN if that address needs a bearer token.
OPENCODE_VERSION=v1.0.0
