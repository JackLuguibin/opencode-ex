# Tests. `bun run test:stack` and `bun run test:smoke` copy this to deploy/.env.test when it is missing. They use the
# Postgres and Redis of development (deploy/.env.dev, started by `bun run dev:infra`) but their own databases, because
# the tests drop tables and clear runtime keys: the scripts create the Postgres databases, and Redis databases 15 and 14
# are separate from the 0 that `dev:app` uses.
OPENCODE_TEST_POSTGRES_URL=postgres://opencode:opencode@127.0.0.1:5436/opencode_test
OPENCODE_TEST_REDIS_URL=redis://127.0.0.1:6380/15
OPENCODE_SMOKE_POSTGRES_URL=postgres://opencode:opencode@127.0.0.1:5436/opencode_smoke
OPENCODE_SMOKE_REDIS_URL=redis://127.0.0.1:6380/14
