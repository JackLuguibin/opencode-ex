OPENCODE_REGISTRY_URL=redis://:change-me-redis@10.0.0.1:6379
# Same Postgres as the execution layers: it records which layer holds each organization.
OPENCODE_IDENTITY_POSTGRES_URL=postgres://opencode:change-me-postgres@10.0.0.1:5432/opencode
OPENCODE_GATEWAY_SECRET=change-me-gateway

# Release to download (a tag published by script/release.sh). Or set OPENCODE_PACKAGE_URL to the package's own address,
# and OPENCODE_PACKAGE_TOKEN if that address needs a bearer token.
OPENCODE_VERSION=v1.0.0

# Browser tab title (default OpenCode).
# OPENCODE_WEB_TITLE=My Company AI
