# Same values on every machine: the two URLs and the secrets. OPENCODE_ADVERTISE_URL is different on each.
OPENCODE_IDENTITY_POSTGRES_URL=postgres://opencode:change-me@10.0.0.1:5432/opencode
OPENCODE_REGISTRY_URL=redis://:change-me-redis@10.0.0.1:6379
OPENCODE_GATEWAY_SECRET=change-me-gateway
OPENCODE_PASSWORD=change-me-operator
# How the gateway reaches THIS layer. Also its registry id; do not change it once organizations live here.
OPENCODE_ADVERTISE_URL=http://10.0.0.2:4096
# First platform administrator, created only when none exists yet.
OPENCODE_ADMIN_EMPLOYEE_ID=admin
OPENCODE_ADMIN_PASSWORD=change-me-admin

# Release to download (a tag published by script/release.sh). Or set OPENCODE_PACKAGE_URL to the package's own address,
# and OPENCODE_PACKAGE_TOKEN if that address needs a bearer token.
OPENCODE_VERSION=v1.0.0
