# Development. `bun run dev:infra` copies this to deploy/.env.dev when it is missing and starts Postgres and Redis from
# deploy/infra.yml; every dev script loads this one file. Change values here (the copy is git-ignored).
# Keep values free of spaces and quotes: the dev scripts source this file with sh.

# Containers (deploy/infra.yml). "auth" keeps the volumes created when these containers belonged to packages/auth.
COMPOSE_PROJECT_NAME=auth
BIND_HOST=127.0.0.1
POSTGRES_PORT=5436
POSTGRES_PASSWORD=opencode
REDIS_PORT=6380
REDIS_PASSWORD=

# Connections
OPENCODE_IDENTITY_POSTGRES_URL=postgres://opencode:opencode@127.0.0.1:5436/opencode
OPENCODE_REGISTRY_URL=redis://127.0.0.1:6380

# Where each piece listens. Execution layers, comma separated; one is started per address, layers after the first keep
# their data under .dev-data/<port>.
OPENCODE_AUTH_URL=http://127.0.0.1:4100
OPENCODE_RUNTIME_URLS=http://127.0.0.1:4097

# Secrets (development only)
OPENCODE_GATEWAY_SECRET=dev-gateway
OPENCODE_SERVER_PASSWORD=change-me
OPENCODE_ADMIN_EMPLOYEE_ID=admin
OPENCODE_ADMIN_PASSWORD=change-me-123

# --- Accounts ---
# An organization id or name that accounts with no organization join when they sign in; created by name when it does
# not exist yet. Leave unset to keep the "waiting for an organization" screen for them.
# OPENCODE_DEFAULT_ORGANIZATION=Other
# Guests: opening the web app starts an anonymous account with no password in the default organization above, without
# showing the login screen. Needs OPENCODE_DEFAULT_ORGANIZATION. Guests are ordinary members of that organization;
# signing out returns to the login screen in that tab.
# OPENCODE_GUEST_ENABLED=true

# Browser tab title (default OpenCode)
# OPENCODE_WEB_TITLE=My Company AI
# Seconds between copies of sessions to the shared Postgres, for analysis. 0 turns the copy off.
# OPENCODE_SESSION_SYNC_INTERVAL=60

# UAC SSO login (corporate account sign-in). Turn on with OPENCODE_UAC_ENABLED=true and set all four; see deploy/.env.prod.example.
# OPENCODE_UAC_ENABLED=true
# OPENCODE_UAC_CREDENTIAL_URL=https://wxlteapi.zte.com.cn/zte-rd-lteact-basic/sso/uacCredential.serv
# OPENCODE_UAC_URI=https://uac.zte.com.cn
# OPENCODE_UAC_TENANT=10001
# OPENCODE_UAC_APP_ID=719597749576
# A UAC account with no organization joins OPENCODE_DEFAULT_ORGANIZATION on sign-in, like any other account.

# Web app: the execution layer the TUI and Vite dev server talk to directly
VITE_OPENCODE_SERVER_HOST=127.0.0.1
VITE_OPENCODE_SERVER_PORT=4096
