# Local development settings, shared by the execution layer, the gateway and the web app.
# Copy to .env.local (git-ignored); `bun run dev:app` loads it. Every line with a default can be left out.
# Every address is one URL, so each piece can run on another machine.

# --- Connections (defaults match `bun run dev:infra`) ---
# Shared Postgres holding accounts, organizations and login sessions.
OPENCODE_IDENTITY_POSTGRES_URL=postgres://opencode:opencode@127.0.0.1:5436/opencode
# Redis where execution layers announce themselves; the gateway reads it to place requests.
OPENCODE_REGISTRY_URL=redis://127.0.0.1:6380

# --- Where each piece listens ---
# The gateway listens here, and the web app connects to it here.
OPENCODE_AUTH_URL=http://127.0.0.1:4100
# Execution layers, comma separated; one is started per address. Each listens on its address, and the gateway reaches
# it there (also its id in the registry). Layers after the first keep their data under .dev-data/<port>.
OPENCODE_RUNTIME_URLS=http://127.0.0.1:4097

# --- Secrets ---
# Signs the actor header between gateway and execution layers; must be identical on both.
OPENCODE_GATEWAY_SECRET=dev-gateway
# Operator password of the execution layer.
OPENCODE_SERVER_PASSWORD=change-me

# --- First platform administrator, created on start when none exists ---
OPENCODE_ADMIN_EMPLOYEE_ID=admin
OPENCODE_ADMIN_PASSWORD=change-me

# Browser tab title (default OpenCode); the gateway serves the page.
# OPENCODE_WEB_TITLE=My Company AI
